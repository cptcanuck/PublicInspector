[flake8]
max-line-length = 120
exclude = 
    .git,
    __pycache__,
    build,
    dist,
    .eggs,
    *.egg-info,
    .venv,
    venv
ignore = 
    E203,
    E266,
    E501,
    W503
per-file-ignores =
    __init__.py:F401

[isort]
profile = black
line_length = 120
skip = .venv,venv,build,dist

[mypy]
python_version = 3.8
warn_return_any = True
warn_unused_configs = True
disallow_untyped_defs = False
ignore_missing_imports = True
